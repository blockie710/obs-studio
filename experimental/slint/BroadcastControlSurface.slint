// Licence: GPL-3.0-or-later
// LibreCast Studio — Slint pilot: MINIMAL callback round-trip surface.
//
// Reduced to the smallest DSL that still proves the §B pilot criteria:
//   1. A .slint component compiles and renders.
//   2. DSL callbacks invoke host C++ (transition_triggered, buffer_size_changed).
//   3. Host C++ pushes reactive properties into Slint (is_streaming).
//
// Deliberately NOT the full demo dock: a large .slint (those are mostly layout
// decoration) generates one enormous template-heavy slint_generated_*_1.cpp TU
// that takes 20-40+ min to compile on MSVC. Keep the pilot surface minimal.
// Telemetry values here are DEAD LABELS (spec §C), never measurements.

import { Button, Slider } from "std-widgets.slint";

export component BroadcastControlSurface inherits Window {
    in-out property <float> t_bar_position: 0.0;
    in-out property <bool> is_streaming: false;

    callback transition_triggered(string);
    callback buffer_size_changed(int);

    background: #0a0a0a;
    title: "LibreCast Slint Pilot";

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        Text {
            text: "LibreCast Slint Surface";
            color: #22d3ee;
            font-size: 14px;
            font-weight: 700;
        }

        Slider {
            minimum: 0.0;
            maximum: 1.0;
            value <=> root.t_bar_position;
            changed => { root.transition_triggered("t_bar"); }
        }

        Text {
            text: root.is_streaming ? "● LIVE" : "○ IDLE";
            color: root.is_streaming ? #ef4444 : #94a3b8;
        }

        Button {
            text: "Set 128-sample buffer";
            clicked => { root.buffer_size_changed(128); }
        }
    }
}
